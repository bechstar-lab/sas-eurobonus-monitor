# seats.aero Pro key (https://seats.aero — $9.99/mnd). Tomt = bruk kun AwardFares-fallback.
SEATS_AERO_KEY=

# SMTP for varsler
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Hvor varsler skal sendes (komma-separert for flere mottakere)
ALERT_EMAIL=jonas@villoid.com

# Hvor mange ganger varsel om samme flight kan sendes (default 1)
DEDUP_WINDOW_DAYS=30
